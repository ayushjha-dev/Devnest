# ========================================================
# DevNest Web Application - Environment Variables Template
# ========================================================
# Duplicate this file to '.env.local' and populate with your credentials.
# DO NOT commit '.env.local' to version control.

# --------------------------------------------------------
# 1. Firebase Client Configuration (Required for Firestore)
# --------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=devnest-club.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=devnest-club
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=devnest-club.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# --------------------------------------------------------
# 2. Admin Portal Authentication (Required for /admin/*)
# --------------------------------------------------------
# Strong password used to access the administrator dashboards
ADMIN_PASSWORD=your_secure_admin_password

# Secret key used for signing administrative session cookies
ADMIN_SESSION_SECRET=your_random_secure_session_secret_min_32_chars

# --------------------------------------------------------
# 3. Firebase Admin SDK (Optional / Server-side)
# --------------------------------------------------------
# Inlined JSON string of service account key (optional if using client SDK)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
